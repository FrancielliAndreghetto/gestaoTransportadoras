{
    "name": "brudam/teste-php-junior",
    "description": "Starter kit — Teste Técnico PHP Júnior",
    "type": "project",
    "require": {
        "php": ">=8.1",
        "robmorgan/phinx": "^0.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php",
            "src/routes.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "optimize-autoloader": true,
        "platform": {
            "php-64bit": "8.1.34",
            "php": "8.1.34"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5.62"
    }
}
